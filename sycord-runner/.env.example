# Cloudflare Tunnel Configuration
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/sycord

# Wildcard Domain (e.g., sycord.site)
CLOUDFLARE_DOMAIN=sycord.site

# API Server Port (internal, tunnel routes to this)
PORT=3000

# Docker Configuration
DOCKER_NETWORK=sycord_network
WORKSPACE_BASE=/opt/sycord/workspace

# Node Environment
NODE_ENV=production
